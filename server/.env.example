# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ai_interview_prep

# Authentication (JWT)
JWT_SECRET=super_secret_jwt_key_change_in_production_min_32_chars
JWT_EXPIRES_IN=7d

# AI Service Configuration (Free Tier APIs)
# Get a free Gemini API key: https://aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Alternative AI Provider: Groq (Optional, free high-speed tier at https://console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# File Upload Settings
MAX_FILE_SIZE_MB=5
UPLOAD_DIR=uploads
